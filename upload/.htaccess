# ----------------------------------------------------------------------
# Catering Ibu Iqbal - Uploads Folder Security
# ----------------------------------------------------------------------

# Disable Directory Browsing for this folder
Options -Indexes

# Disable execution of scripts in this directory
# Prevents arbitrary code execution in case of malicious file uploads
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pl|py|jsp|asp|htm|html|shtml|sh|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>
